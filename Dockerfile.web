# martlyshop.in — Railway service "web" (set RAILWAY_DOCKERFILE_PATH=Dockerfile.web)
# Builds the TanStack Start site and serves it, server-rendered, with server.prod.js.

FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json ./
COPY patches patches
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY apps/mobile/package.json apps/mobile/
COPY apps/rider/package.json apps/rider/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter "@martly/web..."
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN pnpm --filter @martly/web build
ENV NODE_ENV=production
WORKDIR /app/apps/web
EXPOSE 7002
CMD ["node", "server.prod.js"]
