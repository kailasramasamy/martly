{
  "expo": {
    "name": "Martly",
    "slug": "martly",
    "version": "1.0.12",
    "scheme": "martly",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f766e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Martly to use the microphone for voice ordering.",
          "speechRecognitionPermission": "Allow Martly to use speech recognition for voice ordering.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Martly to use the microphone for voice ordering."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "react-native-maps",
              "react-native-google-maps",
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Tamil",
            "ios": "./assets/icon-ta.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-ta.png",
              "backgroundColor": "#0f766e"
            }
          }
        ]
      ],
      "./plugins/with-default-icon-alias",
      "./plugins/with-upi-queries",
      "./plugins/with-release-signing",
      "./plugins/with-notification-color-override",
      "./plugins/with-notification-service-extension"
    ],
    "android": {
      "package": "com.quartex.martly",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      },
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.quartex.martly",
      "buildNumber": "13",
      "appleTeamId": "QBLZB22TU6",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "bhim",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "omnicard",
          "icici",
          "popclubapp",
          "sbiyono",
          "myjio",
          "slice-upi",
          "bobupi",
          "shriramone",
          "indusmobile",
          "whatsapp",
          "kotakbank"
        ]
      }
    }
  }
}
