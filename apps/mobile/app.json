{
  "expo": {
    "name": "Martly",
    "slug": "martly",
    "version": "1.0.13",
    "scheme": "martly",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f766e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Martly uses the microphone so you can order by voice. For example, say \"2 kg onions and 1 litre milk\" and Martly adds them to your cart.",
          "speechRecognitionPermission": "Martly turns your voice into text to fill your cart. For example, saying \"1 kg sugar\" adds sugar to your cart.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Martly uses the microphone so you can order by voice. For example, say \"2 kg onions and 1 litre milk\" and Martly adds them to your cart."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Martly uses your location to show grocery stores that deliver to you and to set your delivery address. For example, it finds stores near your home and pins your house on the map so the rider can reach you. Delivery riders also share their location during a delivery so customers can track the order.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Martly lets you pick photos from your library to attach to reviews and returns. For example, add a photo of a damaged item when you request a return.",
          "cameraPermission": "Martly uses the camera to take product photos. For example, store staff photograph a product pack to add it to the store's catalog.",
          "microphonePermission": "Martly uses the microphone so you can order by voice. For example, say \"2 kg onions and 1 litre milk\" and Martly adds them to your cart."
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "react-native-maps",
              "react-native-google-maps",
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Tamil",
            "ios": "./assets/icon-ta.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-ta.png",
              "backgroundColor": "#0f766e"
            }
          }
        ]
      ],
      "./plugins/with-default-icon-alias",
      "./plugins/with-upi-queries",
      "./plugins/with-release-signing",
      "./plugins/with-notification-color-override",
      "./plugins/with-notification-service-extension"
    ],
    "android": {
      "package": "com.quartex.martly",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      },
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.quartex.martly",
      "buildNumber": "14",
      "appleTeamId": "QBLZB22TU6",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "bhim",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "omnicard",
          "icici",
          "popclubapp",
          "sbiyono",
          "myjio",
          "slice-upi",
          "bobupi",
          "shriramone",
          "indusmobile",
          "whatsapp",
          "kotakbank"
        ]
      }
    }
  }
}
