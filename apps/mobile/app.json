{
  "expo": {
    "name": "Martly",
    "slug": "martly",
    "version": "1.0.0",
    "scheme": "martly",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f766e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Martly to use the microphone for voice ordering.",
          "speechRecognitionPermission": "Allow Martly to use speech recognition for voice ordering.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "react-native-maps",
              "react-native-google-maps",
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ]
    ],
    "android": {
      "package": "com.quartex.martly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      },
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.quartex.martly",
      "buildNumber": "1",
      "appleTeamId": "QBLZB22TU6",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyAOPrWjNw0H_USbXZqnk3_V03FgvSEe6Ko",
        "usesNonExemptEncryption": false
      }
    }
  }
}
