# Server
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/martly_dev

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=martly-media
S3_KEY_PREFIX=
MEDIA_PUBLIC_BASE_URL=https://martly-media.s3.ap-south-1.amazonaws.com

# Anthropic (required for master catalog generation via seed-catalog)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (used for master catalog image generation)
OPENAI_API_KEY=your-openai-api-key

# Seasonal curation agent runs only when both ANTHROPIC_API_KEY and OPENAI_API_KEY are set
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Razorpay (optional — online payments disabled if not set)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay dashboard → Webhooks (event order.paid) → URL /api/v1/payments/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Firebase (optional — push notifications disabled if not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MSG91 OTP (without MSG91_AUTH_KEY, non-production logs the OTP instead of sending SMS)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
MSG91_OTP_TEMPLATE_ID=

# App Store review login: fixed OTP for one phone, never sent by SMS
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=
# Team test phones with a fixed OTP, never sent by SMS: "phone:code,phone:code"
OTP_FIXED_LOGINS=

# Pay by UPI intent (Google Pay/PhonePe/Paytm) via Razorpay server-to-server; needs it enabled on the Razorpay account
RAZORPAY_UPI_S2S=false

# Encrypts payout bank account numbers (64 hex chars: openssl rand -hex 32)
PAYOUT_ACCOUNT_KEY=

# Speech-to-text for spoken lists: SPEECH_PROVIDER=sarvam with a Sarvam key; unset falls back to the phone recogniser
SPEECH_PROVIDER=
SARVAM_API_KEY=

# Shared with martlyshop.in (apps/web): lets the site log searches for its visitors. Required in production
WEB_API_SECRET=
