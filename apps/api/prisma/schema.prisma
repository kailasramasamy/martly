model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  /// Short headline for the offer card, e.g. "Flat ₹50 off"; falls back to one made from the discount
  title          String?
  description    String?
  /**
   * Headline and description in other languages, keyed by language code
   */
  translations   Json?
  /// Advertised to shoppers in Home's offers and checkout's offer list; otherwise used by typing its code
  showOnHome     Boolean      @default(false) @map("show_on_home")
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount Decimal?     @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?     @map("max_discount") @db.Decimal(10, 2)
  usageLimit     Int?         @map("usage_limit")
  perUserLimit   Int          @default(1) @map("per_user_limit")
  usedCount      Int          @default(0) @map("used_count")
  startsAt       DateTime?    @map("starts_at")
  expiresAt      DateTime?    @map("expires_at")
  isActive       Boolean      @default(true) @map("is_active")
  organizationId String?      @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization?      @relation(fields: [organizationId], references: [id])
  redemptions  CouponRedemption[]
  orders       Order[]

  @@index([code])
  @@index([organizationId])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
