enum TripWave {
  SLOT
  EXPRESS
}

model DeliveryTrip {
  id               String     @id @default(uuid())
  storeId          String     @map("store_id")
  /// Empty while PLANNED; set when a rider is assigned
  riderId          String?    @map("rider_id")
  organizationId   String     @map("organization_id")
  status           TripStatus @default(CREATED)
  wave             TripWave   @default(EXPRESS)
  deliverySlotId   String?    @map("delivery_slot_id")
  /// The day this trip delivers on (IST), for slot waves
  slotDate         DateTime?  @map("slot_date") @db.Date
  /// Planner's estimate for the whole route from the store
  plannedDistanceM Int?       @map("planned_distance_m")
  plannedDurationS Int?       @map("planned_duration_s")
  /// Where the trip goes, e.g. "Temple Rd · 636903"
  areaLabel        String?    @map("area_label")
  startedAt        DateTime?  @map("started_at")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  store        Store             @relation(fields: [storeId], references: [id])
  rider        User?             @relation(fields: [riderId], references: [id], onDelete: Restrict)
  organization Organization      @relation(fields: [organizationId], references: [id])
  deliverySlot DeliverySlot?     @relation(fields: [deliverySlotId], references: [id])
  orders       Order[]
  failures     DeliveryFailure[]

  @@index([storeId, status])
  @@index([riderId])
  @@index([storeId, slotDate])
  @@map("delivery_trips")
}

/// How a cash-on-delivery order was actually paid at the door
enum CodCollectionMode {
  CASH
  UPI
}

enum DeliveryFailureReason {
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  CUSTOMER_REFUSED
  PAYMENT_ISSUE
  OTHER
}

/// A delivery attempt that didn't work out; the order went back to the store as READY
model DeliveryFailure {
  id        String                @id @default(uuid())
  orderId   String                @map("order_id")
  tripId    String                @map("trip_id")
  riderId   String                @map("rider_id")
  reason    DeliveryFailureReason
  note      String?
  createdAt DateTime              @default(now()) @map("created_at")

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trip  DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rider User         @relation("DeliveryFailures", fields: [riderId], references: [id])

  @@index([orderId])
  @@index([riderId, createdAt])
  @@map("delivery_failures")
}

/// How a store runs its fleet: trip sizes, rider load, express batching and auto-planning
model StoreDeliverySettings {
  id                    String   @id @default(uuid())
  storeId               String   @unique @map("store_id")
  maxOrdersPerTrip      Int      @default(8) @map("max_orders_per_trip")
  maxTripsPerRider      Int      @default(2) @map("max_trips_per_rider")
  expressBatchSize      Int      @default(3) @map("express_batch_size")
  expressMaxWaitMinutes Int      @default(10) @map("express_max_wait_minutes")
  /// Plan slots at cutoff and batch express orders automatically; opt-in once slots and rosters are set up
  autoPlan              Boolean  @default(false) @map("auto_plan")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_delivery_settings")
}

/// Weekly roster: riders who work a slot (a slot belongs to one weekday)
model SlotRider {
  id        String   @id @default(uuid())
  slotId    String   @map("slot_id")
  riderId   String   @map("rider_id")
  createdAt DateTime @default(now()) @map("created_at")

  slot  DeliverySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  rider User         @relation("SlotRosters", fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([slotId, riderId])
  @@map("slot_riders")
}

/// A one-day change to a slot's roster: a rider off, or an extra rider on
model SlotRiderOverride {
  id        String   @id @default(uuid())
  slotId    String   @map("slot_id")
  riderId   String   @map("rider_id")
  date      DateTime @db.Date
  working   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  slot  DeliverySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  rider User         @relation("SlotRosterOverrides", fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([slotId, riderId, date])
  @@map("slot_rider_overrides")
}

model Banner {
  id              String           @id @default(uuid())
  title           String
  subtitle        String?
  imageUrl        String           @map("image_url")
  imageUrls       Json?            @map("image_urls")
  textInImage     Boolean          @default(false) @map("text_in_image")
  placement       BannerPlacement
  actionType      BannerActionType @default(NONE) @map("action_type")
  actionTarget    String?          @map("action_target")
  sortOrder       Int              @default(0) @map("sort_order")
  isActive        Boolean          @default(true) @map("is_active")
  startsAt        DateTime?        @map("starts_at")
  endsAt          DateTime?        @map("ends_at")
  storeId         String?          @map("store_id")
  organizationId  String?          @map("organization_id")
  departmentId    String?          @map("department_id")
  categoryId      String?          @map("category_id")
  subcategoryId   String?          @map("subcategory_id")
  sponsorType     SponsorType      @default(STORE) @map("sponsor_type")
  brandId         String?          @map("brand_id")
  /// No targets means every eligible store; otherwise stores matching any of these stores, states or districts
  targetStoreIds  String[]         @default([]) @map("target_store_ids")
  targetStates    String[]         @default([]) @map("target_states")
  targetDistricts String[]         @default([]) @map("target_districts")
  /// Prepaid views for CPM campaigns; the feed stops serving the banner once viewsServed reaches it
  viewCap         Int?             @map("view_cap")
  viewsServed     Int              @default(0) @map("views_served")
  /// The promotion this banner belongs to
  promoId         String?          @map("promo_id")
  brandCampaignId String?          @unique @map("brand_campaign_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  promo           Promo?           @relation(fields: [promoId], references: [id], onDelete: SetNull)

  brand         Brand?            @relation(fields: [brandId], references: [id])
  brandCampaign BrandCampaign?    @relation(fields: [brandCampaignId], references: [id], onDelete: SetNull)
  stats         BannerStatDaily[]
  store         Store?            @relation(fields: [storeId], references: [id])
  organization  Organization?     @relation(fields: [organizationId], references: [id])
  department    Department?       @relation(fields: [departmentId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?      @relation(fields: [subcategoryId], references: [id])

  @@index([placement, isActive])
  @@index([organizationId])
  @@index([storeId])
  @@index([brandId])
  @@index([promoId])
  @@map("banners")
}

