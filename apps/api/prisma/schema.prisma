  @@unique([searchLogId, productId, type])
  @@index([productId])
  @@map("search_events")
}

enum CartBuilderSource {
  VOICE
  LIST
  PHOTO
  WHATSAPP
}

// One spoken or written list turned into a cart: what was said, what we offered, what the customer kept
model CartBuilderRun {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  storeId       String            @map("store_id")
  source        CartBuilderSource
  inputText     String            @map("input_text")
  /// Parsed lines with the store product IDs offered for each
  lines         Json
  matchedCount  Int               @map("matched_count")
  pickCount     Int               @map("pick_count")
  notFoundCount Int               @map("not_found_count")
  /// What the customer added, per line; null until they add to cart
  chosen        Json?
  inputTokens   Int               @map("input_tokens")
  outputTokens  Int               @map("output_tokens")
  createdAt     DateTime          @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@map("cart_builder_runs")
}

// A customer's running shopping list: items kept as written, matched to a store only when they build a cart
model ShoppingListItem {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  text      String
  createdAt DateTime  @default(now()) @map("created_at")
  doneAt    DateTime? @map("done_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt])
  @@map("shopping_list_items")
}

/// A shopper's monthly provisions at one store: ready on their reminder day at that day's prices, ordered in one tap
model MonthlyList {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  storeId           String   @map("store_id")
  /// Day of the month the list is ready and reminded (1–28, so every month has it)
  reminderDay       Int      @map("reminder_day")
  pushOn            Boolean  @default(true) @map("push_on")
  whatsappOn        Boolean  @default(true) @map("whatsapp_on")
  isActive          Boolean  @default(true) @map("is_active")
  /// "2026-11": the month last reminded, and the month last ordered
  lastRemindedMonth String?  @map("last_reminded_month")
  lastOrderedMonth  String?  @map("last_ordered_month")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items MonthlyListItem[]

  @@unique([userId, storeId])
  @@index([reminderDay, isActive])
  @@map("monthly_lists")
}

/// One line of a monthly list, in the size the shopper buys
model MonthlyListItem {
  id            String    @id @default(uuid())
  listId        String    @map("list_id")
  productId     String    @map("product_id")
  variantId     String    @map("variant_id")
  quantity      Int
  /// The price when last ordered, for the up/down arrow next to today's price
  lastPrice     Decimal?  @map("last_price") @db.Decimal(10, 2)
  lastOrderedAt DateTime? @map("last_ordered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  list    MonthlyList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([listId, variantId])
  @@map("monthly_list_items")
}

enum StorePostKind {
  FRESH_TODAY
  NEW_IN_STORE
  BACK_IN_STOCK
}

/// The owner speaking to shoppers: what came in, what's new, what's back. Shows on Home and the shop's board until it expires
model StorePost {
  id           String        @id @default(uuid())
  storeId      String        @map("store_id")
  authorId     String        @map("author_id")
  kind         StorePostKind
  text         String
  /// The language the owner wrote in ("ta" | "en"); `translations` holds the other ({ en: { text } })
  language     String
  translations Json?
  expiresAt    DateTime      @map("expires_at")
  notifiedAt   DateTime?     @map("notified_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author   User               @relation(fields: [authorId], references: [id])
  products StorePostProduct[]

  @@index([storeId, expiresAt])
  @@map("store_posts")
}

/// A product the post is about, in the order the owner tagged them
model StorePostProduct {
  id        String @id @default(uuid())
  postId    String @map("post_id")
  productId String @map("product_id")
  position  Int

  post    StorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@map("store_post_products")
}

/// "Owner's pick": a product the owner vouches for at their store, with why in a line; at most 3 an aisle
model StorePick {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  authorId     String   @map("author_id")
  note         String
  language     String
  translations Json?
  createdAt    DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@unique([storeId, productId])
  @@map("store_picks")
}

// How shoppers say things in their language, and the word the catalog lists them under (kadalai maavu → besan).
// Platform-wide language knowledge, read into the shopping-list AI's prompt; managed by Super Admin
model ListGlossaryTerm {
  id         String   @id @default(uuid())
  searchTerm String   @unique @map("search_term")
  note       String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  phrases ListGlossaryPhrase[]

  @@map("list_glossary_terms")
}

// One way of saying a glossary term, in native script or romanised ("கடலை மாவு", "kadalai maavu")
model ListGlossaryPhrase {
  id       String @id @default(uuid())
  termId   String @map("term_id")
  language String
  text     String

  term ListGlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([language, text])
  @@index([termId])
  @@map("list_glossary_phrases")
}

// A promo drafted by the promo agent from an admin's one-line brief: banner + collection + optional discount
model Promo {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  createdById      String            @map("created_by_id")
  brief            String
  kind             PromoKind         @default(AI)
  status           PromoStatus       @default(DRAFTING)
  autoLaunch       Boolean           @default(false) @map("auto_launch")
  notify           Boolean           @default(true)
  failureReason    String?           @map("failure_reason")
  assumptions      String[]          @default([])
  agentLog         Json              @default("[]") @map("agent_log")
  copy             Json?
  push             Json?
  discountType     DiscountType?     @map("discount_type")
  discountValue    Decimal?          @map("discount_value") @db.Decimal(10, 2)
  durationDays     Int               @default(7) @map("duration_days")
  startsAt         DateTime?         @map("starts_at")
  endsAt           DateTime?         @map("ends_at")
  /// Manual promotions: what their banners open, and what their discount covers
  actionType       BannerActionType? @map("action_type")
  actionTarget     String?           @map("action_target")
  /// A ready promotion launches itself at this time
  launchAt         DateTime?         @map("launch_at")
  collectionId     String?           @unique @map("collection_id")
  campaignId       String?           @unique @map("campaign_id")
  chargedFrom      PromoCharge?      @map("charged_from")
  regenerations    Int               @default(0)
  /// The owner's own banner image; when set, no AI art is generated
  uploadedImageUrl String?           @map("uploaded_image_url")
  brandCampaignId  String?           @map("brand_campaign_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  createdBy     User                   @relation(fields: [createdById], references: [id])
  collection    Collection?            @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  campaign      NotificationCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  brandCampaign BrandCampaign?         @relation(fields: [brandCampaignId], references: [id], onDelete: SetNull)
  banners       Banner[]
  priceChanges  PromoPriceChange[]
  creditEntries PromotionCreditEntry[]

  @@index([organizationId, status])
  @@index([brandCampaignId])
  @@index([status, endsAt])
  @@map("promos")
}

// A store listing whose discount a promo overwrote, with the discount it had before, for end/undo to restore
model PromoPriceChange {
  id                String        @id @default(uuid())
  promoId           String        @map("promo_id")
  storeProductId    String        @map("store_product_id")
  prevDiscountType  DiscountType? @map("prev_discount_type")
  prevDiscountValue Decimal?      @map("prev_discount_value") @db.Decimal(10, 2)
  prevDiscountStart DateTime?     @map("prev_discount_start")
  prevDiscountEnd   DateTime?     @map("prev_discount_end")
  restoredAt        DateTime?     @map("restored_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  promo        Promo        @relation(fields: [promoId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@unique([promoId, storeProductId])
  @@index([storeProductId])
  @@map("promo_price_changes")
}

// A product a store manager photographed for the catalog agent to read, clean up and list in their store
model CatalogDraft {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  storeId         String             @map("store_id")
  createdById     String             @map("created_by_id")
  status          CatalogDraftStatus @default(QUEUED)
  hintName        String?            @map("hint_name")
  mrp             Decimal            @db.Decimal(10, 2)
  sellingPrice    Decimal            @map("selling_price") @db.Decimal(10, 2)
  stock           Int                @default(0)
  photos          String[]
  // Per shot: the image used for the listing and the fidelity check's verdict, filled as each shot finishes
  processedImages Json               @default("[]") @map("processed_images")
  // What the agent read and decided: label fields, brand and subcategory picks, confidences
  extracted       Json?
  reviewReasons   String[]           @default([]) @map("review_reasons")
  productId       String?            @map("product_id")
  matchedExisting Boolean            @default(false) @map("matched_existing")
  attempts        Int                @default(0)
  error           String?
  // Tokens and estimated USD per pipeline step
  usage           Json               @default("[]")
  claimedAt       DateTime?          @map("claimed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, claimedAt])
  @@index([storeId, createdAt])
  @@map("catalog_drafts")
}

enum StockMovementType {
  RECEIVE
  COUNT
  DAMAGE
  EXPIRY
  MANUAL
  SALE
  UNDO_SALE
  RETURN
}

/// Every change to a store product's on-hand stock, with who made it and why
model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  storeId        String            @map("store_id")
  storeProductId String            @map("store_product_id")
  type           StockMovementType
  /// Signed change applied to stock
  quantity       Int
  stockBefore    Int               @map("stock_before")
  stockAfter     Int               @map("stock_after")
  note           String?
  userId         String?           @map("user_id")
  stockCountId   String?           @map("stock_count_id")
  orderId        String?           @map("order_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  stockCount   StockCount?  @relation(fields: [stockCountId], references: [id], onDelete: SetNull)

  @@index([storeProductId, createdAt])
  @@index([storeId, createdAt])
  @@map("stock_movements")
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  /// Sent back to the counter to redo selected lines (still blind)
  RECOUNT
  APPROVED
  REJECTED
}

enum StockCountRevisionKind {
  COUNT
  RECOUNT
  CORRECTION
}

/// A blind shelf count: counters enter quantities without seeing system stock; an approver applies the differences
model StockCount {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  storeId        String           @map("store_id")
  subcategoryId  String           @map("subcategory_id")
  status         StockCountStatus @default(DRAFT)
  note           String?
  createdById    String           @map("created_by_id")
  submittedAt    DateTime?        @map("submitted_at")
  reviewedById   String?          @map("reviewed_by_id")
  reviewedAt     DateTime?        @map("reviewed_at")
  reviewNote     String?          @map("review_note")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subcategory  Subcategory      @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("StockCountsCreated", fields: [createdById], references: [id])
  reviewedBy   User?            @relation("StockCountsReviewed", fields: [reviewedById], references: [id])
  lines        StockCountLine[]
  movements    StockMovement[]

  @@index([storeId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id               String    @id @default(uuid())
  stockCountId     String    @map("stock_count_id")
  storeProductId   String    @map("store_product_id")
  countedQty       Int       @map("counted_qty")
  /// System stock snapshotted when the count (or its recount) is submitted
  systemQty        Int?      @map("system_qty")
  /// Flagged by the approver to be counted again
  recountRequested Boolean   @default(false) @map("recount_requested")
  /// The counter's working number during a recount, kept apart so they never see the earlier one
  recountQty       Int?      @map("recount_qty")
  /// Set when this line was applied to stock ahead of the rest of the count
  appliedAt        DateTime? @map("applied_at")

  stockCount   StockCount               @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct             @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  revisions    StockCountLineRevision[]

  @@unique([stockCountId, storeProductId])
  @@map("stock_count_lines")
}

/// Append-only history of a count line: first count, recounts and approver corrections
model StockCountLineRevision {
  id        String                 @id @default(uuid())
  lineId    String                 @map("line_id")
  kind      StockCountRevisionKind
  qty       Int
  reason    String?
  userId    String                 @map("user_id")
  createdAt DateTime               @default(now()) @map("created_at")

  line StockCountLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id])

  @@index([lineId])
  @@map("stock_count_line_revisions")
}

/// Price list for everything Martly sells to store owners and brands; orders snapshot the price
model AdProduct {
  id                       String           @id @default(uuid())
  kind                     AdProductKind
  code                     String           @unique
  name                     String
  description              String?
  price                    Decimal          @db.Decimal(10, 2)
  durationDays             Int              @default(30) @map("duration_days")
  promotionCredits         Int              @default(0) @map("promotion_credits")
  /// AI images an organisation may ask for each month (promotions include their own art)
  aiImagesPerMonth         Int              @default(0) @map("ai_images_per_month")
  /// AI image packs: images per pack
  aiImageCredits           Int              @default(0) @map("ai_image_credits")
  pushIncluded             Boolean          @default(false) @map("push_included")
  /// Brand packages: where the banner runs
  placement                BannerPlacement?
  /// CPM packages: views bought per unit
  viewsPerUnit             Int?             @map("views_per_unit")
  /// Store plans: the Razorpay plan that bills this price monthly (made when first needed)
  /// Store plans: the price when paid for a year up front; null means no annual option
  yearlyPrice              Decimal?         @map("yearly_price") @db.Decimal(10, 2)
  razorpayPlanId           String?          @map("razorpay_plan_id")
  razorpayPlanAmount       Int?             @map("razorpay_plan_amount")
  razorpayYearlyPlanId     String?          @map("razorpay_yearly_plan_id")
  razorpayYearlyPlanAmount Int?             @map("razorpay_yearly_plan_amount")
  isActive                 Boolean          @default(true) @map("is_active")
  sortOrder                Int              @default(0) @map("sort_order")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  orders      AdOrder[]
  planPeriods OrgPlanPeriod[]
  campaigns   BrandCampaign[]

  subscriptions MarketingSubscription[]

  @@index([kind, isActive])
  @@map("ad_products")
}

/// Singleton (id "default") with platform-wide marketing settings
model MarketingConfig {
  id                 String   @id @default("default")
  gstPercent         Decimal  @default(18) @map("gst_percent") @db.Decimal(4, 2)
  /// { [placement]: { STORE?: n, BRAND?: n, PLATFORM?: n } }; a missing entry means no cap
  slotLimits         Json     @default("{}") @map("slot_limits")
  freeRegenerations  Int      @default(2) @map("free_regenerations")
  /// Featured brands that can run at once in one category
  featuredBrandSlots Int      @default(2) @map("featured_brand_slots")
  sellerName         String   @default("Martly") @map("seller_name")
  sellerGstin        String?  @map("seller_gstin")
  sellerState        String   @default("Tamil Nadu") @map("seller_state")
  sellerAddress      String?  @map("seller_address")
  invoicePrefix      String   @default("MKT") @map("invoice_prefix")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("marketing_config")
}

model AdOrder {
  id                String          @id @default(uuid())
  /// Invoice number, assigned when paid
  number            String?         @unique
  organizationId    String?         @map("organization_id")
  brandId           String?         @map("brand_id")
  productId         String          @map("product_id")
  quantity          Int             @default(1)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(10, 2)
  subtotal          Decimal         @db.Decimal(10, 2)
  gstPercent        Decimal         @map("gst_percent") @db.Decimal(4, 2)
  cgst              Decimal         @default(0) @db.Decimal(10, 2)
  sgst              Decimal         @default(0) @db.Decimal(10, 2)
  igst              Decimal         @default(0) @db.Decimal(10, 2)
  total             Decimal         @db.Decimal(10, 2)
  /// Store plans: a month or a year of the plan
  billingInterval   BillingInterval @default(MONTHLY) @map("billing_interval")
  status            AdOrderStatus   @default(PENDING)
  razorpayOrderId   String?         @unique @map("razorpay_order_id")
  razorpayPaymentId String?         @unique @map("razorpay_payment_id")
  /// Billing name, GSTIN, address and state at purchase time
  billing           Json            @default("{}")
  /// Paid outside Razorpay (bank transfer), recorded by the Martly team
  offlineReference  String?         @map("offline_reference")
  createdById       String          @map("created_by_id")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization   Organization?          @relation(fields: [organizationId], references: [id])
  brand          Brand?                 @relation(fields: [brandId], references: [id])
  product        AdProduct              @relation(fields: [productId], references: [id])
  createdBy      User                   @relation(fields: [createdById], references: [id])
  planPeriod     OrgPlanPeriod?
  credits        PromotionCreditEntry[]
  aiImageCredits AiImageCreditEntry[]
  campaign       BrandCampaign?

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@index([status])
  @@map("ad_orders")
}

model MarketingInvoiceCounter {
  /// Financial year label, e.g. "2026-27"
  fy   String @id
  last Int    @default(0)

  @@map("marketing_invoice_counters")
}

/// A paid month of a store plan; periods stack when bought before the current one ends
model OrgPlanPeriod {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  adOrderId      String?   @unique @map("ad_order_id")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  /// Set once the scheduler has applied the downgrade after this period
  closedAt       DateTime? @map("closed_at")
  /// A free trial month: no order behind it, and nothing to carry into an upgrade
  isTrial        Boolean   @default(false) @map("is_trial")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      AdProduct    @relation(fields: [productId], references: [id])
  adOrder      AdOrder?     @relation(fields: [adOrderId], references: [id])

  @@index([organizationId, endsAt])
  @@map("org_plan_periods")
}

/// Every promotion credit movement: plan allowance used/refunded (fromPlan) and bought top-ups (balance = sum of delta)
/// Append-only ledger of an organisation's AI images: the plan's monthly allowance moves and bought packs
model AiImageCreditEntry {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  delta          Int
  /// Plan allowance moves (not counted in the bought balance) vs. bought packs
  fromPlan       Boolean               @default(false) @map("from_plan")
  reason         PromotionCreditReason
  purpose        AiImagePurpose?
  /// What was painted: the promo, collection or Home section
  refId          String?               @map("ref_id")
  adOrderId      String?               @map("ad_order_id")
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  adOrder      AdOrder?     @relation(fields: [adOrderId], references: [id])

  @@index([organizationId, createdAt])
  @@map("ai_image_credit_entries")
}

model PromotionCreditEntry {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  delta          Int
  /// Plan allowance moves (not counted in the bought balance) vs. bought top-ups
  fromPlan       Boolean               @default(false) @map("from_plan")
  reason         PromotionCreditReason
  promoId        String?               @map("promo_id")
  adOrderId      String?               @map("ad_order_id")
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  promo        Promo?       @relation(fields: [promoId], references: [id], onDelete: SetNull)
  adOrder      AdOrder?     @relation(fields: [adOrderId], references: [id])

  @@index([organizationId])
  @@map("promotion_credit_entries")
}

model BannerStatDaily {
  bannerId String   @map("banner_id")
  storeId  String   @map("store_id")
  date     DateTime @db.Date
  views    Int      @default(0)
  taps     Int      @default(0)

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([bannerId, storeId, date])
  @@index([storeId, date])
  @@map("banner_stats_daily")
}

/// Shopper views, taps and cart adds per Home section per store per day
model HomeSectionStatDaily {
  storeId     String   @map("store_id")
  /// The layout entry's id (saved section or default layout key)
  sectionId   String   @map("section_id")
  sectionType String   @map("section_type")
  date        DateTime @db.Date
  views       Int      @default(0)
  taps        Int      @default(0)
  cartAdds    Int      @default(0) @map("cart_adds")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, sectionId, date])
  @@index([storeId, date])
  @@map("home_section_stats_daily")
}

/// A store's storefront health score once a day, for its trend
model StorefrontHealthSnapshot {
  storeId String   @map("store_id")
  date    DateTime @db.Date
  score   Int
  /// Score per group, e.g. { LOOKS: 40, DEALS: 75 }
  groups  Json

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, date])
  @@map("storefront_health_snapshots")
}

/// A brand the store owner promotes in their stores (a distributor deal, a local favourite), ranked like their own brands
model BrandCampaign {
  id              String              @id @default(uuid())
  brandId         String              @map("brand_id")
  productId       String              @map("product_id")
  status          BrandCampaignStatus @default(DRAFT)
  title           String
  subtitle        String?
  imageUrl        String?             @map("image_url")
  /// Brief for AI art/products when the brand asks Martly to make the creative
  brief           String?
  /// Null for a featured brand: it boosts the brand's products instead of running a banner
  placement       BannerPlacement?
  categoryId      String?             @map("category_id")
  actionType      BannerActionType    @default(BRAND) @map("action_type")
  actionTarget    String?             @map("action_target")
  /// No targets means every store that stocks the brand; otherwise stores matching any of these stores, states or districts
  targetStoreIds  String[]            @default([]) @map("target_store_ids")
  targetStates    String[]            @default([]) @map("target_states")
  targetDistricts String[]            @default([]) @map("target_districts")
  discountType    DiscountType?       @map("discount_type")
  discountValue   Decimal?            @map("discount_value") @db.Decimal(10, 2)
  /// Units of the package bought (weeks, or thousands of views for CPM)
  quantity        Int                 @default(1)
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  adOrderId       String?             @unique @map("ad_order_id")
  reviewNote      String?             @map("review_note")
  createdById     String              @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  brand     Brand     @relation(fields: [brandId], references: [id])
  product   AdProduct @relation(fields: [productId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
  adOrder   AdOrder?  @relation(fields: [adOrderId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  banner    Banner?
  promos    Promo[]

  @@index([brandId, status])
  @@index([status, startsAt])
  @@map("brand_campaigns")
}

/// Each AI banner painted: which layout and style it used (so the next one looks different) and whose allowance it used
model BannerArtRun {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id")
  brandId        String?          @map("brand_id")
  purpose        BannerArtPurpose
  layout         String
  style          String
  imageUrl       String?          @map("image_url")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@map("banner_art_runs")
}

/// A store plan that renews itself monthly through a Razorpay subscription (UPI AutoPay or card mandate)
model MarketingSubscription {
  id                     String                      @id @default(uuid())
  organizationId         String                      @map("organization_id")
  productId              String                      @map("product_id")
  razorpaySubscriptionId String                      @unique @map("razorpay_subscription_id")
  interval               BillingInterval             @default(MONTHLY)
  status                 MarketingSubscriptionStatus @default(CREATED)
  /// The owner turned auto-renew off; the plan runs to the end of the paid month
  cancelAtPeriodEnd      Boolean                     @default(false) @map("cancel_at_period_end")
  /// A plan change that waits for the current month to end starts billing here
  startAt                DateTime?                   @map("start_at")
  createdById            String                      @map("created_by_id")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      AdProduct    @relation(fields: [productId], references: [id])

  @@index([organizationId, status])
  @@map("marketing_subscriptions")
}

model AlertOnce {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("alert_once")
}

enum WalletRechargeStatus {
  PENDING
  PAID
}

model WalletRecharge {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  razorpayOrderId   String               @unique @map("razorpay_order_id")
  razorpayPaymentId String?              @unique @map("razorpay_payment_id")
  amount            Decimal              @db.Decimal(10, 2)
  status            WalletRechargeStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_recharges")
}

enum HomeSectionType {
  FESTIVE_HERO
  MEMBER_CHIPS
  HERO_BANNERS
  BUY_AGAIN
  RECENTLY_VIEWED
  DEPARTMENT_GRID
  BRAND_RAIL
  PLUS_PROMO
  TIME_PICKS
  DEALS
  RECIPES
  LIVE_CAMPAIGNS
  OTHER_COLLECTIONS
  CATEGORY_DIRECTORY
  OFFERS
  BRAND_POSTERS
  PERSONALISED
  PRODUCT_ROW
  CAMPAIGN_CARD
  TABBED_ROW
  PRICE_BAND_DEALS
  BRAND_CARD
  EXPLORE_GRID
  STORE_GRID
  BESTSELLER_CATEGORIES
  THEME_BAND
  STORE_SPECIALS
  BUY_GET_DEALS
  HERO_CARDS
  STORE_WALK
  MONTHLY_LIST
  STORE_POSTS
}

/// One block on an organisation's Home, in display order; config holds per-type display settings
model HomeSection {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  type           HomeSectionType
  title          String?
  subtitle       String?
  translations   Json?
  collectionId   String?         @map("collection_id")
  config         Json            @default("{}")
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection   Collection?       @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  items        HomeSectionItem[]

  @@index([organizationId, isActive, sortOrder])
  @@map("home_sections")
}

/// A tab, tile or aisle override inside a Home section
model HomeSectionItem {
  id             String   @id @default(uuid())
  sectionId      String   @map("section_id")
  label          String
  translations   Json?
  imageUrl       String?  @map("image_url")
  collectionId   String?  @map("collection_id")
  subcategoryIds String[] @default([]) @map("subcategory_ids")
  wide           Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")

  section    HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@map("home_section_items")
}

/// Positive amounts mean Martly owes the store, negative that the store owes Martly
enum LedgerEntryType {
  SALE_ONLINE
  SALE_WALLET
  PLATFORM_COUPON
  RETURN_REFUND
  DOOR_REFUND
  REFERRAL_REWARD
  GOODWILL_DEBIT
  MEMBERSHIP_SALE
  PLAN_FEE
  BALANCE_PAYMENT
  REVERSAL
  ADJUSTMENT
  SETTLEMENT_PAYOUT
  COMMISSION
  COMMISSION_REFUND
}

enum LedgerSourceType {
  ORDER
  RETURN
  REFERRAL
  MEMBERSHIP
  WALLET_TXN
  AD_ORDER
  BALANCE_DUE
  SETTLEMENT
  LEDGER_ENTRY
  MANUAL
}

/// The running account between Martly and each store. Append-only: corrections are reversing entries.
model LedgerEntry {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  /// Null for organization-level entries (memberships, plan fees, payouts)
  storeId        String?          @map("store_id")
  type           LedgerEntryType
  amount         Decimal          @db.Decimal(12, 2)
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String           @map("source_id")
  orderId        String?          @map("order_id")
  /// Settleable from this time; sales wait out the return window
  availableAt    DateTime         @map("available_at")
  settlementId   String?          @map("settlement_id")
  memo           String
  /// Staff or super admin behind a manual entry
  createdBy      String?          @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  settlement   Settlement?  @relation(fields: [settlementId], references: [id])

  @@unique([type, sourceId])
  @@index([organizationId, storeId, createdAt])
  @@index([organizationId, settlementId, availableAt])
  @@index([orderId])
  @@map("ledger_entries")
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  FAILED
  CARRIED_FORWARD
}

enum PayoutMethod {
  BANK_TRANSFER
  UPI
}

/// A weekly payout run for one organization; carried-forward and failed nets roll into the next one
model Settlement {
  id             String           @id @default(uuid())
  number         String           @unique
  organizationId String           @map("organization_id")
  periodStart    DateTime         @map("period_start")
  periodEnd      DateTime         @map("period_end")
  credits        Decimal          @db.Decimal(12, 2)
  debits         Decimal          @db.Decimal(12, 2)
  carriedIn      Decimal          @map("carried_in") @db.Decimal(12, 2)
  net            Decimal          @db.Decimal(12, 2)
  status         SettlementStatus @default(DRAFT)
  payoutMethod   PayoutMethod?    @map("payout_method")
  utr            String?
  paidAt         DateTime?        @map("paid_at")
  paidBy         String?          @map("paid_by")
  failureReason  String?          @map("failure_reason")
  /// The settlement this one's net was rolled into
  carriedIntoId  String?          @map("carried_into_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  carriedInto  Settlement?   @relation("SettlementCarry", fields: [carriedIntoId], references: [id])
  carriedFrom  Settlement[]  @relation("SettlementCarry")
  entries      LedgerEntry[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("settlements")
}

model SettlementCounter {
  /// Financial year label, e.g. "2026-27"
  fy   String @id
  last Int    @default(0)

  @@map("settlement_counters")
}

/// Where an organization's payouts go. The account number is stored encrypted; only its last 4 digits are shown.
model OrgPayoutAccount {
  id               String    @id @default(uuid())
  organizationId   String    @unique @map("organization_id")
  accountHolder    String    @map("account_holder")
  accountNumberEnc String?   @map("account_number_enc")
  accountLast4     String?   @map("account_last4")
  ifsc             String?
  upiVpa           String?   @map("upi_vpa")
  verifiedAt       DateTime? @map("verified_at")
  verifiedBy       String?   @map("verified_by")
  updatedBy        String    @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("org_payout_accounts")
}

enum BalanceDueStatus {
  PENDING
  PAID
  CANCELLED
}

/// Money an organization owes Martly when refunds outran sales; paid online or by transfer
model BalanceDue {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  amount            Decimal          @db.Decimal(12, 2)
  status            BalanceDueStatus @default(PENDING)
  razorpayOrderId   String?          @unique @map("razorpay_order_id")
  razorpayPaymentId String?          @unique @map("razorpay_payment_id")
  offlineReference  String?          @map("offline_reference")
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("balance_dues")
}

/// A store's own-brand pack artwork, printed onto products' blank pouch photos at render time
model PackDesign {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  name           String
  /// Pouch geometry the artwork is printed onto, a key of PACK_TEMPLATES in services/pack-render
  template       String
  frontArtUrl    String   @map("front_art_url")
  backArtUrl     String?  @map("back_art_url")
  /// Product text drawn over the artwork: PackZone[] from services/pack-render
  zones          Json
  /// Subcategories this design packs; the default design packs everything else
  subcategoryIds String[] @default([]) @map("subcategory_ids")
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("pack_designs")
}
