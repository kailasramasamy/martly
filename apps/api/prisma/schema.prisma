generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────

enum UserRole {
  BRAND_PARTNER
  SUPER_ADMIN
  ORG_ADMIN
  STORE_MANAGER
  STAFF
  RIDER
  CUSTOMER
}

enum Permission {
  ORDERS_VIEW
  ORDERS_PROCESS
  ORDERS_DISPATCH
  ORDERS_CANCEL
  DELIVERY_DELIVER
  RIDERS_MANAGE
  CATALOG_PRODUCTS
  CATALOG_BRANDS
  CATALOG_COLLECTIONS
  LISTING_AVAILABILITY
  LISTING_MANAGE
  LISTING_PRICES
  STOCK_VIEW
  STOCK_RECEIVE
  STOCK_COUNT
  STOCK_ADJUST
  STOCK_APPROVE
  RETURNS_HANDLE
  SUPPORT_HANDLE
  REFUNDS_ISSUE
  MARKETING_MANAGE
  DELIVERY_CONFIG
  STORE_SETTINGS
  TEAM_MANAGE
  REPORTS_VIEW
  FINANCE_MANAGE
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Shop format chosen at onboarding; sets how many aisles and brands its proposed catalog carries
enum StoreSize {
  KIRANA
  SUPERMARKET
  HYPERMARKET
}

/// How widely an aisle is stocked: every kirana, a regular supermarket, or only large stores
enum SubcategoryTier {
  ESSENTIAL
  STANDARD
  EXTENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UnitType {
  KG
  GRAM
  LITER
  ML
  PIECE
  PACK
  DOZEN
  BUNDLE
}

enum FoodType {
  VEG
  NON_VEG
  VEGAN
  EGG
}

enum ProductType {
  GROCERY
  SNACKS
  BEVERAGES
  DAIRY
  FROZEN
  FRESH_PRODUCE
  BAKERY
  PERSONAL_CARE
  HOUSEHOLD
  BABY_CARE
  PET_CARE
  OTC_PHARMA
}

enum StorageType {
  AMBIENT
  REFRIGERATED
  DEEP_CHILLED
  FROZEN
  COOL_DRY
  HUMIDITY_CONTROLLED
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

/// How a manager settled a listing's onboarding price: kept it, or changed its price/MRP
enum PriceReviewOutcome {
  KEPT
  CHANGED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  REVERSAL
  ADJUSTMENT
}

enum TripStatus {
  /// Built by the planner, waiting for a rider
  PLANNED
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionKind {
  STANDARD
  OCCASION
  SEASON
  PROMO
  STORE_SPECIAL
}

enum PromoStatus {
  DRAFTING
  READY
  LIVE
  ENDED
  FAILED
  DISCARDED
}

enum CatalogDraftStatus {
  QUEUED
  PROCESSING
  NEEDS_REVIEW
  PUBLISHED
  DUPLICATE
  FAILED
  DISCARDED
}

enum CurationSource {
  MANUAL
  AGENT
}

enum BannerPlacement {
  HERO_CAROUSEL
  CATEGORY_TOP
  /// Tall brand posters in a rail on Home
  HOME_POSTER
  /// A brand's product marked "Ad": second in Home rows and category listings of its category, first in matching searches, suggestions and list orders
  SPONSORED_PRODUCT
  /// The shopper tab bar's last slot: a brand's logo, opening its brand page
  BRAND_TAB
}

enum BannerActionType {
  BRAND
  CATEGORY
  PRODUCT
  COLLECTION
  SEARCH
  URL
  NONE
}

enum AdProductKind {
  STORE_PLAN
  PROMOTION_TOPUP
  AI_IMAGE_PACK
  BRAND_BANNER
  BRAND_TAKEOVER
  BRAND_PROMOTION
  BRAND_CPM
  BRAND_SPONSORED_PRODUCT
  BRAND_FEATURE
  BRAND_TAB_SLOT
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum MarketingSubscriptionStatus {
  CREATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
}

enum AdOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PromotionCreditReason {
  TOPUP
  USED
  REFUND
  ADJUST
}

/// What an organisation's AI images were spent on
enum AiImagePurpose {
  PROMO_BANNER
  COLLECTION_BANNER
  FESTIVE_HERO
  HOME_TILES
}

enum PromoKind {
  AI
  MANUAL
}

enum PromoCharge {
  PLAN
  TOPUP
  BRAND
  PLATFORM
}

enum SponsorType {
  STORE
  BRAND
  PLATFORM
}

enum BrandCampaignStatus {
  DRAFT
  PENDING_PAYMENT
  IN_REVIEW
  SCHEDULED
  LIVE
  ENDED
  REJECTED
  CANCELLED
}

enum BannerArtPurpose {
  PROMO
  SEASONAL
  BANNER
  BRAND
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  WALLET_CREDITED
  WALLET_DEBITED
  LOYALTY_POINTS_EARNED
  LOYALTY_POINTS_REDEEMED
  PROMOTIONAL
  GENERAL
  WELCOME
  REVIEW_REQUEST
  NEW_ORDER
  PAYMENT
  DELIVERY_UPDATE
  RETURN_UPDATE
  SUPPORT_UPDATE
  MEMBERSHIP
  SUBSCRIPTION
  REFERRAL
  WISHLIST_ALERT
  STORE_NOTICE
  STAFF_ORDER
  STAFF_STOCK
  STAFF_DELIVERY
  STAFF_SERVICE
  STAFF_MARKETING
  STAFF_TEAM
  STAFF_FINANCE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum AudienceType {
  ALL_CUSTOMERS
  STORE_CUSTOMERS
  ORDERED_LAST_N_DAYS
  NOT_ORDERED_N_DAYS
  HIGH_VALUE_CUSTOMERS
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReturnRequestStatus {
  PENDING
  /// Approved; waiting for the item to come back and/or the replacement to go out
  IN_PROGRESS
  /// Resolved: refunded or replaced, with the item back when one was needed
  APPROVED
  REJECTED
  /// The item never came back in time
  EXPIRED
}

/// What the customer gets for an approved return
enum ReturnRemedy {
  REFUND
  REPLACE
}

/// How the returned item gets back to the store
enum RefundDestination {
  WALLET
  /// The store hands the cash back: the rider on collection, or the counter on a drop
  CASH
}

enum WalletTxnReason {
  ORDER_PAYMENT
  CANCEL_REFUND
  RETURN_REFUND
  DOOR_REFUND
  REFERRAL
  RECHARGE
  SUPPORT
  SUBSCRIPTION
  FORFEIT
}

enum ReturnMethod {
  /// Not worth collecting; the customer keeps it
  KEEP
  /// The rider collects it with the customer's next order
  NEXT_ORDER
  /// The customer drops it at the store
  AT_STORE
}

/// Why a customer handed an item back to the rider at the door
enum RefuseReason {
  DAMAGED
  EXPIRED
  WRONG_ITEM
  NOT_WANTED
}

enum MembershipDuration {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionFrequency {
  DAILY
  ALTERNATE_DAYS
  SPECIFIC_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionDeliveryMode {
  DEDICATED
  SLOT_BASED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ── Models ────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptionEnabled Boolean   @default(false) @map("subscription_enabled")
  festivalRegions     String[]  @default(["ALL"]) @map("festival_regions")
  promoDiscountCap    Int       @default(20) @map("promo_discount_cap")
  billingName         String?   @map("billing_name")
  gstin               String?
  billingAddress      String?   @map("billing_address")
  billingState        String?   @map("billing_state")
  /// The organisation's own brands rank like market leaders in search and lead category listings
  boostOwnBrands      Boolean   @default(true) @map("boost_own_brands")
  /// When the organisation started its one free Growth trial
  trialUsedAt         DateTime? @map("trial_used_at")
  /// Martly's commission, GST included: on online payments, and on COD and wallet payments
  onlineCommissionPct Decimal   @default(4) @map("online_commission_pct") @db.Decimal(5, 2)
  codCommissionPct    Decimal   @default(2) @map("cod_commission_pct") @db.Decimal(5, 2)
  /// A storefront source: onboarding copies its Home layout, collections and banners into new organisations
  isTemplate          Boolean   @default(false) @map("is_template")

  stores                Store[]
  products              Product[]
  collections           Collection[]
  coupons               Coupon[]
  deliveryZones         DeliveryZone[]
  loyaltyConfig         LoyaltyConfig?
  loyaltyBalances       LoyaltyBalance[]
  loyaltyTransactions   LoyaltyTransaction[]
  deliveryTrips         DeliveryTrip[]
  banners               Banner[]
  notificationCampaigns NotificationCampaign[]
  notificationTemplates NotificationTemplate[]
  promos                Promo[]
  referralConfig        ReferralConfig?
  referrals             Referral[]
  supportTickets        SupportTicket[]
  returnRequests        ReturnRequest[]
  ledgerEntries         LedgerEntry[]
  settlements           Settlement[]
  payoutAccount         OrgPayoutAccount?
  balanceDues           BalanceDue[]
  membershipPlans       MembershipPlan[]
  userMemberships       UserMembership[]
  subscriptions         Subscription[]
  recipes               Recipe[]
  catalogDrafts         CatalogDraft[]
  memberPermissions     MemberPermission[]
  brands                Brand[]
  stockMovements        StockMovement[]
  stockCounts           StockCount[]
  adOrders              AdOrder[]
  planPeriods           OrgPlanPeriod[]
  promotionCredits      PromotionCreditEntry[]
  aiImageCredits        AiImageCreditEntry[]

  bannerArtRuns BannerArtRun[]

  marketingSubscriptions MarketingSubscription[]
  homeSections           HomeSection[]
  packDesigns            PackDesign[]

  @@map("organizations")
}

model Store {
  id                    String      @id @default(uuid())
  organizationId        String      @map("organization_id")
  name                  String
  /// Unique within its town: the shop lives at onmartly.in/{town}/{slug}
  slug                  String
  townId                String      @map("town_id")
  address               String
  /// State (INDIAN_STATES name) and district, copied from the town, for region-targeted brand campaigns
  state                 String?
  district              String?
  phone                 String?
  imageUrl              String?     @map("image_url")
  status                StoreStatus @default(PENDING)
  latitude              Float?      @map("latitude")
  longitude             Float?      @map("longitude")
  deliveryRadius        Float       @default(7) @map("delivery_radius")
  minOrderAmount        Decimal?    @map("min_order_amount")
  freeDeliveryThreshold Decimal?    @map("free_delivery_threshold")
  /// Returns worth up to this much default to "refund, keep it"
  returnKeepThreshold   Decimal?    @map("return_keep_threshold") @db.Decimal(10, 2)
  baseDeliveryFee       Decimal?    @map("base_delivery_fee")
  size                  StoreSize?
  /// The onboarding catalog adjustments and pricing last applied, so the wizard reopens with them
  catalogRules          Json?       @map("catalog_rules")
  launchedAt            DateTime?   @map("launched_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Branding shown to shoppers choosing a store
  logoUrl      String?  @map("logo_url")
  promoImages  String[] @default([]) @map("promo_images")
  tagline      String?
  offerText    String?  @map("offer_text")
  brandColor   String?  @map("brand_color")
  highlights   String[] @default([])
  // Per language: { tagline, offerText }
  translations Json?

  subscriptionEnabled      Boolean                  @default(false) @map("subscription_enabled")
  subscriptionDeliveryMode SubscriptionDeliveryMode @default(DEDICATED) @map("subscription_delivery_mode")
  subscriptionWindowStart  String?                  @map("subscription_window_start")
  subscriptionWindowEnd    String?                  @map("subscription_window_end")
  subscriptionCutoffTime   String                   @default("22:00") @map("subscription_cutoff_time")

  organization          Organization           @relation(fields: [organizationId], references: [id])
  town                  Town                   @relation(fields: [townId], references: [id])
  storeProducts         StoreProduct[]
  userStores            UserStore[]
  orders                Order[]
  reviews               Review[]
  storeDeliveryZones    StoreDeliveryZone[]
  deliveryTiers         DeliveryTier[]
  deliverySlots         DeliverySlot[]
  monthlyLists          MonthlyList[]
  posts                 StorePost[]
  picks                 StorePick[]
  expressDeliveryConfig ExpressDeliveryConfig?
  deliverySettings      StoreDeliverySettings?
  deliveryTrips         DeliveryTrip[]
  banners               Banner[]
  storeRatings          StoreRating[]          @relation("StoreRatings")
  supportTickets        SupportTicket[]
  returnRequests        ReturnRequest[]
  ledgerEntries         LedgerEntry[]
  subscriptions         Subscription[]
  basketAddOns          BasketAddOn[]
  searchLogs            SearchLog[]
  cartBuilderRuns       CartBuilderRun[]
  stockMovements        StockMovement[]
  stockCounts           StockCount[]
  catalogDrafts         CatalogDraft[]

  bannerStats      BannerStatDaily[]
  homeSectionStats HomeSectionStatDaily[]
  healthSnapshots  StorefrontHealthSnapshot[]
  wishlistItems    WishlistItem[]
  packDesigns      PackDesign[]

  @@unique([townId, slug])
  @@map("stores")
}

/// A town or village Martly lists stores under; the name repeats across districts, the slug never does
model Town {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  district  String
  /// INDIAN_STATES name
  state     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores Store[]

  @@unique([state, district, name])
  @@map("towns")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  phone        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  walletBalance          Decimal   @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  referralCode           String?   @unique @map("referral_code")
  razorpayCustomerId     String?   @unique @map("razorpay_customer_id")
  preferredPaymentMethod String?   @map("preferred_payment_method")
  lastUpiVpa             String?   @map("last_upi_vpa")
  deletedAt              DateTime? @map("deleted_at")
  /// The brand a BRAND_PARTNER advertises for
  brandId                String?   @map("brand_id")

  brand               Brand?                   @relation("BrandPartners", fields: [brandId], references: [id])
  userStores          UserStore[]
  orders              Order[]
  deviceTokens        DeviceToken[]
  addresses           UserAddress[]
  reviews             Review[]
  wishlistItems       WishlistItem[]
  walletRecharges     WalletRecharge[]
  couponRedemptions   CouponRedemption[]
  walletTransactions  WalletTransaction[]
  loyaltyBalances     LoyaltyBalance[]
  loyaltyTransactions LoyaltyTransaction[]
  deliveryTrips       DeliveryTrip[]
  slotRosters         SlotRider[]              @relation("SlotRosters")
  slotRosterOverrides SlotRiderOverride[]      @relation("SlotRosterOverrides")
  deliveryFailures    DeliveryFailure[]        @relation("DeliveryFailures")
  notifications       Notification[]
  campaignsSent       NotificationCampaign[]   @relation("CampaignsSent")
  templatesCreated    NotificationTemplate[]   @relation("TemplatesCreated")
  reviewReplies       ReviewReply[]            @relation("ReviewReplies")
  storeRatings        StoreRating[]            @relation("StoreRatings")
  priceReviews        StoreProduct[]           @relation("PriceReviews")
  carryChecks         StoreProduct[]           @relation("CarryChecks")
  referralsMade       Referral[]               @relation("ReferralsMade")
  referralReceived    Referral[]               @relation("ReferralReceived")
  supportTickets      SupportTicket[]
  returnRequests      ReturnRequest[]
  memberships         UserMembership[]
  subscriptions       Subscription[]
  basketAddOns        BasketAddOn[]
  searchLogs          SearchLog[]
  cartBuilderRuns     CartBuilderRun[]
  shoppingListItems   ShoppingListItem[]
  monthlyLists        MonthlyList[]
  storePosts          StorePost[]
  storePicks          StorePick[]
  promosCreated       Promo[]
  catalogDrafts       CatalogDraft[]
  memberPermissions   MemberPermission[]
  stockMovements      StockMovement[]
  stockCountsCreated  StockCount[]             @relation("StockCountsCreated")
  stockCountsReviewed StockCount[]             @relation("StockCountsReviewed")
  stockCountRevisions StockCountLineRevision[]
  adOrdersCreated     AdOrder[]
  brandCampaigns      BrandCampaign[]

  @@index([brandId])
  @@map("users")
}

model UserAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String   @default("Home")
  placeName String?  @map("place_name")
  address   String
  latitude  Float?   @map("latitude")
  longitude Float?   @map("longitude")
  pincode   String?  @map("pincode")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

/// Add-on permissions an owner grants a staff member, on top of their role's preset, within one organization
model MemberPermission {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  permissions    Permission[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("member_permissions")
}

model UserStore {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@map("user_stores")
}

model Department {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  sortOrder     Int      @default(0) @map("sort_order")
  imageUrl      String?  @map("image_url")
  /// A photo of this department's aisle in a local shop, behind the hanging sign on Walk the store
  aisleImageUrl String?  @map("aisle_image_url")
  translations  Json?    @map("translations")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  categories Category[]
  banners    Banner[]

  @@map("departments")
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  departmentId String   @map("department_id")
  sortOrder    Int      @default(0) @map("sort_order")
  imageUrl     String?  @map("image_url")
  translations Json?    @map("translations")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department    Department    @relation(fields: [departmentId], references: [id])
  subcategories Subcategory[]
  banners       Banner[]

  brandCampaigns BrandCampaign[]

  @@index([departmentId])
  @@map("categories")
}

model Subcategory {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  categoryId   String          @map("category_id")
  sortOrder    Int             @default(0) @map("sort_order")
  imageUrl     String?         @map("image_url")
  translations Json?           @map("translations")
  // Words shoppers use for this aisle ("shaving" → Razor & Blades); search matches products here by intent
  searchTerms  String[]        @default([]) @map("search_terms")
  // Used up and bought again (milk, detergent); off for durables and seasonal items, which reorder suggestions skip
  restockable  Boolean         @default(true)
  tier         SubcategoryTier @default(STANDARD)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  category    Category     @relation(fields: [categoryId], references: [id])
  products    Product[]
  banners     Banner[]
  stockCounts StockCount[]

  @@index([categoryId])
  @@index([searchTerms], type: Gin)
  @@map("subcategories")
}

model Brand {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  imageUrl            String?  @map("image_url")
  // Brand's primary and accent colours (hex), used to theme its brand store
  themeColor          String?  @map("theme_color")
  themeColorSecondary String?  @map("theme_color_secondary")
  // 0–100 shopper recognition in India; breaks search ties so market leaders rank first
  popularity          Int      @default(0)
  /// Region codes (FESTIVAL_REGIONS) where shoppers buy it, home state first; ["ALL"] for national brands, empty until reviewed
  regions             String[] @default([])
  /// null = master brand shared by every organization; set = an organization's own local brand
  organizationId      String?  @map("organization_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  partners     User[]          @relation("BrandPartners")
  adOrders     AdOrder[]
  banners      Banner[]
  campaigns    BrandCampaign[]

  @@index([organizationId])
  @@map("brands")
}

model Product {
  id                  String       @id @default(uuid())
  name                String
  /// martlyshop.in/p/{slug}; a database trigger makes it from the name on insert and it never changes after
  slug                String       @unique @default(dbgenerated())
  description         String?
  imageUrl            String?      @map("image_url")
  subcategoryId       String?      @map("subcategory_id")
  brandId             String?      @map("brand_id")
  isActive            Boolean      @default(true) @map("is_active")
  /// Created but not launched yet; its store listings stay off until the owner launches it
  isDraft             Boolean      @default(false) @map("is_draft")
  tags                String[]     @default([])
  hsnCode             String?      @map("hsn_code")
  gstPercent          Decimal?     @map("gst_percent") @db.Decimal(4, 2)
  foodType            FoodType?    @map("food_type")
  fssaiLicense        String?      @map("fssai_license")
  ingredients         String?
  nutritionalInfo     Json?        @map("nutritional_info")
  allergens           String[]     @default([])
  servingSize         String?      @map("serving_size")
  shelfLifeDays       Int?         @map("shelf_life_days")
  storageType         StorageType? @map("storage_type")
  storageInstructions String?      @map("storage_instructions")
  manufacturerName    String?      @map("manufacturer_name")
  countryOfOrigin     String?      @map("country_of_origin")
  images              String[]     @default([])
  /// Blank clear pouch filled with this product; stores' pack designs are printed onto it (services/pack-render)
  packPhotoUrl        String?      @map("pack_photo_url")
  productType         ProductType? @map("product_type")
  regulatoryMarks     String[]     @default([]) @map("regulatory_marks")
  certifications      String[]     @default([])
  mfgLicenseNo        String?      @map("mfg_license_no")
  dangerWarnings      String?      @map("danger_warnings")
  usageInstructions   String?      @map("usage_instructions")
  translations        Json?        @map("translations")
  organizationId      String?      @map("organization_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  searchText String @default("") @map("search_text")

  organization     Organization?      @relation(fields: [organizationId], references: [id])
  subcategory      Subcategory?       @relation(fields: [subcategoryId], references: [id])
  brand            Brand?             @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  storeProducts    StoreProduct[]
  orderItems       OrderItem[]
  monthlyListItems MonthlyListItem[]
  collectionItems  CollectionItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  searchAliases    SearchAlias[]
  searchEvents     SearchEvent[]
  recipeItems      RecipeItem[]
  catalogDrafts    CatalogDraft[]
  storePostItems   StorePostProduct[]
  storePicks       StorePick[]

  @@index([productType])
  @@index([organizationId])
  @@index([tags], type: Gin)
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String
  sku       String?  @unique
  barcode   String?  @unique
  unitType  UnitType @default(PIECE) @map("unit_type")
  unitValue Decimal  @default(1) @map("unit_value") @db.Decimal(10, 2)
  mrp       Decimal? @db.Decimal(10, 2)
  packType  String?  @map("pack_type")
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  discountType  DiscountType? @map("discount_type")
  discountValue Decimal?      @map("discount_value") @db.Decimal(10, 2)
  discountStart DateTime?     @map("discount_start")
  discountEnd   DateTime?     @map("discount_end")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeProducts    StoreProduct[]
  orderItems       OrderItem[]
  monthlyListItems MonthlyListItem[]

  @@map("product_variants")
}

model StoreProduct {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  productId         String   @map("product_id")
  variantId         String   @map("variant_id")
  price             Decimal  @db.Decimal(10, 2)
  stock             Int      @default(0)
  reservedStock     Int      @default(0) @map("reserved_stock")
  isActive          Boolean  @default(true) @map("is_active")
  isFeatured        Boolean  @default(false) @map("is_featured")
  lowStockThreshold Int?     @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  discountType  DiscountType? @map("discount_type")
  discountValue Decimal?      @map("discount_value") @db.Decimal(10, 2)
  discountStart DateTime?     @map("discount_start")
  discountEnd   DateTime?     @map("discount_end")
  memberPrice   Decimal?      @map("member_price") @db.Decimal(10, 2)

  /// The MRP on this store's packs when it differs from the master variant's; customers see mrp ?? variant.mrp
  mrp                Decimal?            @db.Decimal(10, 2)
  priceReviewedAt    DateTime?           @map("price_reviewed_at")
  priceReviewedById  String?             @map("price_reviewed_by_id")
  priceReviewOutcome PriceReviewOutcome? @map("price_review_outcome")
  /// Whether the store stocks it: null is onboarding's guess, false is "not sold here" (always hidden)
  carried            Boolean?
  /// What `carried` was before the last stock-check write, so its undo puts it back
  carriedBefore      Boolean?            @map("carried_before")
  carryCheckedAt     DateTime?           @map("carry_checked_at")
  carryCheckedById   String?             @map("carry_checked_by_id")
  /// Onboarding listed it hidden, as a less likely pick the store can switch on; records origin, never cleared
  suggested          Boolean             @default(false)

  /// Buy X get Y free on this product: every offerBuyQty paid units bring offerGetQty free ones
  offerBuyQty Int?      @map("offer_buy_qty")
  offerGetQty Int?      @map("offer_get_qty")
  offerStart  DateTime? @map("offer_start")
  offerEnd    DateTime? @map("offer_end")

  store                 Store                      @relation(fields: [storeId], references: [id])
  product               Product                    @relation(fields: [productId], references: [id])
  variant               ProductVariant             @relation(fields: [variantId], references: [id])
  orderItems            OrderItem[]
  subscriptionItems     SubscriptionItem[]
  basketAddOns          BasketAddOn[]
  subscriptionOverrides SubscriptionItemOverride[]
  promoPriceChanges     PromoPriceChange[]
  stockMovements        StockMovement[]
  stockCountLines       StockCountLine[]
  priceReviewedBy       User?                      @relation("PriceReviews", fields: [priceReviewedById], references: [id])
  carryCheckedBy        User?                      @relation("CarryChecks", fields: [carryCheckedById], references: [id])

  @@unique([storeId, variantId])
  @@index([storeId, priceReviewedAt])
  @@index([storeId, carried])
  @@map("store_products")
}

model Order {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  storeId             String          @map("store_id")
  status              OrderStatus     @default(PENDING)
  paymentStatus       PaymentStatus   @default(PENDING) @map("payment_status")
  paymentMethod       PaymentMethod   @default(ONLINE) @map("payment_method")
  fulfillmentType     FulfillmentType @default(DELIVERY) @map("fulfillment_type")
  totalAmount         Decimal         @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress     String?         @map("delivery_address")
  deliveryLat         Float?          @map("delivery_lat")
  deliveryLng         Float?          @map("delivery_lng")
  razorpayOrderId     String?         @map("razorpay_order_id")
  razorpayPaymentId   String?         @map("razorpay_payment_id")
  couponId            String?         @map("coupon_id")
  couponCode          String?         @map("coupon_code")
  couponDiscount      Decimal?        @map("coupon_discount") @db.Decimal(10, 2)
  deliveryFee         Decimal         @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliveryDistance    Float?          @map("delivery_distance")
  deliveryPincode     String?         @map("delivery_pincode")
  estimatedDeliveryAt DateTime?       @map("estimated_delivery_at")
  deliveryNotes       String?         @map("delivery_notes")
  walletAmountUsed    Decimal?        @map("wallet_amount_used") @db.Decimal(10, 2)
  /// Value of items the customer handed back to the rider at the door
  refusedAmount       Decimal         @default(0) @map("refused_amount") @db.Decimal(10, 2)
  loyaltyPointsUsed   Int?            @map("loyalty_points_used")
  loyaltyPointsEarned Int?            @map("loyalty_points_earned")
  deliverySlotId      String?         @map("delivery_slot_id")
  deliveryTripId      String?         @map("delivery_trip_id")
  deliverySequence    Int?            @map("delivery_sequence")
  scheduledDate       DateTime?       @map("scheduled_date")
  slotStartTime       String?         @map("slot_start_time")
  slotEndTime         String?         @map("slot_end_time")
  subscriptionId      String?         @map("subscription_id")
  isSubscriptionOrder Boolean         @default(false) @map("is_subscription_order")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  store               Store                @relation(fields: [storeId], references: [id])
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  deliverySlot        DeliverySlot?        @relation(fields: [deliverySlotId], references: [id])
  deliveryTrip        DeliveryTrip?        @relation(fields: [deliveryTripId], references: [id])
  deliveryFailures    DeliveryFailure[]
  /// Set when a COD order is delivered: cash in the rider's hand, or UPI straight to the store
  codCollectedVia     CodCollectionMode?   @map("cod_collected_via")
  /// Recorded on delivery: what the customer kept paying for, and Martly's commission on it. Returns refund at this rate.
  commissionBase      Decimal?             @map("commission_base") @db.Decimal(10, 2)
  commissionAmount    Decimal?             @map("commission_amount") @db.Decimal(10, 2)
  items               OrderItem[]
  couponRedemptions   CouponRedemption[]
  statusLogs          OrderStatusLog[]
  walletTransactions  WalletTransaction[]
  loyaltyTransactions LoyaltyTransaction[]
  storeRatings        StoreRating[]
  reviews             Review[]
  supportTickets      SupportTicket[]
  returnRequest       ReturnRequest?       @relation("ReturnRequestOrder")
  collectedReturns    ReturnRequest[]      @relation("ReturnCollectedOn")
  ledgerEntries       LedgerEntry[]

  @@index([storeId, status])
  @@map("orders")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("unknown")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  variantId      String  @map("variant_id")
  storeProductId String  @map("store_product_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice     Decimal @map("total_price") @db.Decimal(10, 2)

  originalPrice Decimal?      @map("original_price") @db.Decimal(10, 2)
  discountType  DiscountType? @map("discount_type")
  discountValue Decimal?      @map("discount_value") @db.Decimal(10, 2)
  /// Units of quantity that came free under a buy X get Y offer; totalPrice covers only the rest
  freeQuantity  Int           @default(0) @map("free_quantity")

  /// Units the customer handed back to the rider at the door
  refusedQuantity   Int           @default(0) @map("refused_quantity")
  refusedReason     RefuseReason? @map("refused_reason")
  /// Set on a free item sent to replace a returned one
  replacesReturnId  String?       @map("replaces_return_id")
  /// The Home section the shopper added it from, for the storefront's "what's working"
  sourceSectionId   String?       @map("source_section_id")
  sourceSectionType String?       @map("source_section_type")

  order              Order               @relation(fields: [orderId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  variant            ProductVariant      @relation(fields: [variantId], references: [id])
  storeProduct       StoreProduct        @relation(fields: [storeProductId], references: [id])
  returnRequestItems ReturnRequestItem[]
  replacesReturn     ReturnRequest?      @relation(fields: [replacesReturnId], references: [id])

  @@map("order_items")
}

model Collection {
  id              String         @id @default(uuid())
  organizationId  String?        @map("organization_id")
  title           String
  subtitle        String?
  slug            String         @unique
  imageUrl        String?        @map("image_url")
  sortOrder       Int            @default(0) @map("sort_order")
  isActive        Boolean        @default(true) @map("is_active")
  kind            CollectionKind @default(STANDARD)
  startsAt        DateTime?      @map("starts_at")
  endsAt          DateTime?      @map("ends_at")
