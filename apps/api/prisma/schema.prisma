model ReturnRequest {
  id                 String              @id @default(uuid())
  orderId            String              @unique @map("order_id")
  userId             String              @map("user_id")
  organizationId     String              @map("organization_id")
  storeId            String              @map("store_id")
  status             ReturnRequestStatus @default(PENDING)
  reason             String
  description        String?
  images             String[]            @default([])
  requestedAmount    Decimal             @map("requested_amount") @db.Decimal(10, 2)
  approvedAmount     Decimal?            @map("approved_amount") @db.Decimal(10, 2)
  adminNote          String?             @map("admin_note")
  resolvedAt         DateTime?           @map("resolved_at")
  resolvedBy         String?             @map("resolved_by")
  remedy             ReturnRemedy?
  method             ReturnMethod?
  /// The rider collected the item while delivering this order
  collectedOnOrderId String?             @map("collected_on_order_id")
  receivedAt         DateTime?           @map("received_at")
  receivedBy         String?             @map("received_by")
  refundedAt         DateTime?           @map("refunded_at")
