      ]
    },
    {
      "match": "^Urad\\ Dal\\ Split$",
      "path": [
        "Grocery & Staples",
        "Dal & Pulses",
        "Urad Dal"
      ]
    },
    {
      "match": "^Moong\\ Dal$",
      "path": [
        "Grocery & Staples",
        "Dal & Pulses",
        "Moong Dal"
      ]
    },
    {
      "match": "^Chana\\ Dal$",
      "path": [
        "Grocery & Staples",
        "Dal & Pulses",
        "Chana Dal"
      ]
    },
    {
      "match": "^Idli\\ Rice$",
      "path": [
        "Grocery & Staples",
        "Rice",
        "Idli & Dosa Rice"
      ]
    },
    {
      "match": "^Iodised\\ Table\\ Salt$",
      "path": [
        "Grocery & Staples",
        "Salt & Sugar",
        "Iodised Salt"
      ]
    },
    {
      "match": "^Iodised\\ Crystal\\ Salt$",
      "path": [
        "Grocery & Staples",
        "Salt & Sugar",
