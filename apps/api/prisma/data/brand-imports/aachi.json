    { "match": "Pure Ghee", "path": ["Grocery & Staples", "Ghee", "Cow Ghee"] },
    { "match": "Jam$", "path": ["Grocery & Staples", "Sauces & Condiments", "Jam & Marmalade"] },
    { "match": "Kasuri Methi", "path": ["Grocery & Staples", "Spices & Masala", "Herbs & Seasonings"] },
    { "match": "^(Byadagi |Kashmiri )?(Chilli|Turmeric|Coriander|Pepper|Cumin|Fennel|Asafoetida) Powder$", "path": ["Grocery & Staples", "Spices & Masala", "Ground Spices"] },
    { "match": "Masala|Powder|Mix", "path": ["Grocery & Staples", "Spices & Masala", "Blended Masala"] }
