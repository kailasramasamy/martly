    { "match": "Rava Idly Mix", "path": ["Snacks & Packaged Foods", "Ready to Eat & Cook", "Instant Upma & Poha"] },
    { "match": "Vermicelli", "path": ["Snacks & Packaged Foods", "Instant Noodles & Pasta", "Vermicelli (Sevai)"] },
    { "match": "Rice$", "path": ["Grocery & Staples", "Rice", "Non-Basmati Rice"] },
    { "match": "Ragi Flour", "path": ["Grocery & Staples", "Atta & Flours", "Ragi Flour"] },
    { "match": "Puttu Powder|Maavu", "path": ["Grocery & Staples", "Atta & Flours", "Rice Flour"] },
    { "match": "Bajji Bonda Powder", "path": ["Grocery & Staples", "Atta & Flours", "Besan (Gram Flour)"] },
