{
  "brand": "Thums Up (Coca-Cola)",
  "manufacturer": "Hindustan Coca-Cola Beverages Pvt. Ltd.",
  "feed": "thums-up-feed.json",
  "themeColor": "#1C3F94",
  "themeColorSecondary": "#E31E24",
  "namePrefix": "Thums Up ",
  "foodType": "VEG",
  "exclude": [],
  "aliases": {
    "Thums Up Sparkling Soft Drink": "Soft Drink"
  },
  "rules": [
    {
      "match": "^Soft\\ Drink$",
      "path": [
        "Beverages",
        "Soft Drinks & Carbonated",
        "Cola"
      ]
    },
    {
      "match": "^XForce\\ Zero\\ Sugar\\ Soft\\ Drink$",
      "path": [
        "Beverages",
        "Soft Drinks & Carbonated",
        "Diet & Zero Sugar"
      ]
    },
    {
      "match": "^Charged\\ Berry\\ Bolt$",
      "path": [
        "Beverages",
        "Health & Energy Drinks",
        "Glucose & Energy Drinks"
      ]
    }
  ],
  "logo": "https://martly-media.s3.ap-south-1.amazonaws.com/brands/thums-up/logo-80625891.png"
}